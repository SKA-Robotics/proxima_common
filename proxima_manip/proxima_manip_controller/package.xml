  <version>0.0.1</version>
  <description>Hardware interfaces implementation for the Proxima rover manipulator using ros2_control</description>
  <maintainer email="mucharski.selim@gmail.com">smuchars</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake_auto</buildtool_depend>

  <depend>hardware_interface</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
