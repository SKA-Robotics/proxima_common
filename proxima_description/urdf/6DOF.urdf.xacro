<?xml version="1.0" ?>
<!-- =================================================================================== -->
<!-- |    Author:       Klaudia Niedziałkowska                                         | -->
<!-- =================================================================================== -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="six_dof_arm">

  <xacro:macro name="six_dof_arm_macro">

    <xacro:property name="scale" value="0.001 0.001 0.001"/>

    <xacro:property name="mesh_global_roll" value="package://proxima_description/meshes/manipulators/6DOF/global_roll_assembly.STL"/>
    <xacro:property name="mesh_base_assy" value="package://proxima_description/meshes/manipulators/6DOF/base_assy.STL"/>
    <xacro:property name="mesh_gp1" value="package://proxima_description/meshes/manipulators/6DOF/GP1.STL"/>
    <xacro:property name="mesh_gp2" value="package://proxima_description/meshes/manipulators/6DOF/GP2.STL"/>
    <xacro:property name="mesh_wrist_diff_base" value="package://proxima_description/meshes/manipulators/6DOF/wrist_diff_base.STL"/>
    <xacro:property name="mesh_wrist_diff_output" value="package://proxima_description/meshes/manipulators/6DOF/wrist_diff_output.STL"/>
    <xacro:property name="mesh_gripper" value="package://proxima_description/meshes/manipulators/6DOF/gripper.STL"/>

    <link name="root_link">
      <visual>
        <geometry>
          <mesh filename="${mesh_global_roll}" scale="${scale}"/>
        </geometry>
        <origin xyz="0.0 0.0 0.1" rpy="0.0 0.0 0.0"/>
        <material name="purple">
          <color rgba="0.64 0.13 0.91 1.0"/>
        </material>
      </visual>
      <collision>
        <geometry>
            <mesh filename="${mesh_global_roll}" scale="${scale}"/>
        </geometry>
        <origin xyz="0.0 0.0 0.1" rpy="0.0 0.0 0.0"/>
      </collision>
    </link>

    <link name="link_1">
      <visual>
        <geometry>
          <mesh filename="${mesh_base_assy}" scale="${scale}"/>
        </geometry>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        <material name="purple">
          <color rgba="0.64 0.13 0.91 1.0"/>
        </material>
      </visual>
      <collision>
        <geometry>
            <mesh filename="${mesh_base_assy}" scale="${scale}"/>
        </geometry>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
      </collision>
    </link>

    <joint name="joint_1" type="revolute">
      <parent link="root_link"/>
      <child link="link_1"/>
      <axis xyz="0 0 1"/>
      <limit lower="-3.14" upper="3.14" effort="1000.0" velocity="0.5"/>
      <origin xyz="0 0 0.1" rpy="0 0 0"/>
    </joint>

    <link name="link_2"> 
      <visual>
        <geometry>
          <mesh filename="${mesh_gp1}" scale="${scale}"/>
        </geometry>
        <origin xyz="0 0 0" rpy="0.0 0.0 0.0"/>
        <material name="pink">
          <color rgba="0.902 0.349 0.971 1.0"/>
        </material>
      </visual>
      <collision>
        <geometry>
          <mesh filename="${mesh_gp1}" scale="${scale}"/>
        </geometry>
        <origin xyz="0 0 0" rpy="0.0 0.0 0.0"/>
      </collision>
    </link>

    <joint name="joint_2" type="revolute">
      <parent link="link_1"/>
      <child link="link_2"/>
      <axis xyz="1 0 0"/>
      <limit lower="-1.58" upper="1.58" effort="1000.0" velocity="0.5"/>
      <origin xyz="0.02727 0.0 0.07" rpy="0 0 0"/>
    </joint>

    <link name="link_3">
      <visual>
        <geometry>
          <mesh filename="${mesh_gp2}" scale="${scale}"/>
        </geometry>
        <origin xyz="0 0 0" rpy="0.0 0.0 0.0"/>
        <material name="purple">
          <color rgba="0.64 0.13 0.91 1.0"/>
        </material>
      </visual>
      <collision>
        <geometry>
            <mesh filename="${mesh_gp2}" scale="${scale}"/>
        </geometry>
        <origin xyz="0 0 0" rpy="0.0 0.0 0.0"/>
      </collision>
    </link>

    <joint name="joint_3" type="revolute">
      <parent link="link_2"/>
      <child link="link_3"/>
      <axis xyz="1 0 0"/>
      <limit lower="-1.58" upper="1.58" effort="1000.0" velocity="0.5"/>
      <origin xyz="0.04573 0 0.495" rpy="1.57079632679 0 0"/>
    </joint>

    <link name="link_4">
      <visual>
        <geometry>
          <mesh filename="${mesh_wrist_diff_base}" scale="${scale}"/>
        </geometry>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        <material name="pink">
          <color rgba="0.902 0.349 0.971 1.0"/>
        </material>
      </visual>
      <collision>
        <geometry>
            <mesh filename="${mesh_wrist_diff_base}" scale="${scale}"/>
        </geometry>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
      </collision>
    </link>

    <joint name="joint_4" type="revolute">
      <parent link="link_3"/>
      <child link="link_4"/>
      <axis xyz="0 0 1"/>
      <limit lower="-3.14" upper="3.14" effort="1000.0" velocity="0.5"/>
      <origin xyz="0.06 0 0.29" rpy="0 0 0"/>
    </joint>

    <link name="link_5">
      <visual>
        <geometry>
          <mesh filename="${mesh_wrist_diff_output}" scale="${scale}"/>
        </geometry>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        <material name="purple">
          <color rgba="0.0 0.0 1.0 1.0"/>
        </material>
      </visual>
      <collision>
        <geometry>
          <mesh filename="${mesh_wrist_diff_output}" scale="${scale}"/>
        </geometry>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
      </collision>
    </link>

    <joint name="joint_5" type="revolute">
      <parent link="link_4"/>
      <child link="link_5"/>
      <axis xyz="0 1 0"/>
      <limit lower="-1.55" upper="1.55" effort="1000.0" velocity="0.5"/>
      <origin xyz="0 0 0.07825 " rpy="0.0 0 0"/>
    </joint>

    <link name="tcp_connector">
      <visual>
        <geometry>
          <mesh filename="${mesh_gripper}" scale="${scale}"/>
        </geometry>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        <material name="pink">
          <color rgba="0.0 0.0 1.0 1.0"/>
        </material>
      </visual>
      <collision>
        <geometry>
          <mesh filename="${mesh_gripper}" scale="${scale}"/>
        </geometry>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
      </collision>
    </link>

    <joint name="joint_6" type="revolute">
      <origin xyz="0 0.0 0.04" rpy="0 0 0"/>
      <parent link="link_5"/>
      <child link="tcp_connector"/>
      <axis xyz="0 0 1"/>
      <limit lower="-3.14" upper="3.14" effort="1000.0" velocity="0.5"/>
    </joint>

  </xacro:macro>

</robot>